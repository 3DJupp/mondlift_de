# Header für Dateien, die Cloudflare ohne den Worker ausliefert.
#
# CSS, JS, Bilder und das Favicon sind in wrangler.jsonc von
# run_worker_first ausgenommen, damit sie keine Worker-Anfragen kosten.
# Die Security-Header aus src/headers.ts kommen deshalb hier an sie heran.
# Die CSP ist strenger als bei den Seiten: diese Dateien laden selbst nichts.
# Wer in src/headers.ts etwas ändert, prüft auch diese Datei.

/assets/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vorschaubild für geteilte Links. Manche Foren und Web-Clients binden es
# direkt im Browser des Lesers ein, statt es selbst abzuholen; mit
# same-origin bliebe die Vorschau dort leer. Die Zeile mit dem
# Ausrufezeichen nimmt den Wert von oben zurück, sonst stünden beide da.
# Das Video dazu liegt unter /video/ und läuft über den Worker.
/assets/og/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/favicon.svg
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
