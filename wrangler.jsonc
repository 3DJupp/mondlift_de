{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mondlift-de",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-07",

  // Bündelt die Animation vor jedem dev, preview und deploy. Das Ergebnis
  // unter public/assets/js/mondlift.js ist deshalb nicht eingecheckt.
  "build": {
    "command": "npm run build"
  },

  // Static Assets. Der Worker läuft zuerst, damit jede Antwort - auch CSS,
  // JS und Bilder - dieselben Security-Header bekommt. Danach reicht der
  // Worker an das Asset-Binding weiter.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Custom Domains. Die Zone-/Account-IDs stehen absichtlich nicht hier:
  // Wrangler nimmt sie aus CLOUDFLARE_ACCOUNT_ID bzw. aus dem Login.
  "routes": [
    { "pattern": "mondlift.de", "custom_domain": true },
    { "pattern": "www.mondlift.de", "custom_domain": true }
  ],

  // Öffentliche Variablen. Der Turnstile Site Key ist öffentlich und steht
  // ohnehin im HTML - der Secret Key gehört dagegen in `wrangler secret put`.
  // Leer lassen heißt: kein Widget im Formular.
  "vars": {
    "TURNSTILE_SITE_KEY": ""
  },

  // Rate Limits fürs Kontaktformular, pro IP. Die Periode darf nur 10 oder
  // 60 Sekunden sein, längere Fenster kann dieses Binding nicht.
  // Der strenge Limiter greift nur für Einsendungen ohne Turnstile-Token.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMIT_STRICT",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 }
    }
  ],

  // Zustellung des Kontaktformulars. Darf nur an verifizierte
  // Zieladressen des Accounts senden - siehe README.
  "send_email": [{ "name": "CONTACT_MAILER" }],

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // Einstellungen für Preview-Deployments (wrangler preview, z. B. aus einem
  // Pull Request). Previews erben nichts von oben, deshalb steht hier alles
  // noch einmal - bewusst mit preview-sicheren Werten statt der echten.
  "previews": {
    // Offizieller Turnstile-Testschlüssel von Cloudflare. Öffentlich und für
    // genau diesen Zweck gedacht: das Widget wird gerendert, sodass sich die
    // Seite im Preview ansehen lässt.
    "vars": {
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
    },

    // Eigene Namespaces, damit Previews nicht am selben Zähler wie die
    // Produktion drehen.
    "ratelimits": [
      {
        "name": "CONTACT_RATE_LIMIT",
        "namespace_id": "2001",
        "simple": { "limit": 3, "period": 60 }
      },
      {
        "name": "CONTACT_RATE_LIMIT_STRICT",
        "namespace_id": "2002",
        "simple": { "limit": 1, "period": 60 }
      }
    ],

    // Binding vorhanden, aber ohne Secrets stellt ein Preview nichts zu:
    // CONTACT_TO_EMAIL und CONTACT_FROM_EMAIL sind dort nicht gesetzt, also
    // antwortet das Formular mit einem Fehler statt eine Mail zu schicken.
    // Das ist Absicht - ein Preview soll nicht ungefragt Post verschicken.
    "send_email": [{ "name": "CONTACT_MAILER" }]
  }
}
