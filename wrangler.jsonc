{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mondlift-de",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-07",

  // Static Assets. Der Worker läuft zuerst, damit jede Antwort - auch CSS,
  // JS und Bilder - dieselben Security-Header bekommt. Danach reicht der
  // Worker an das Asset-Binding weiter.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Custom Domains. Die Zone-/Account-IDs stehen absichtlich nicht hier:
  // Wrangler nimmt sie aus CLOUDFLARE_ACCOUNT_ID bzw. aus dem Login.
  "routes": [
    { "pattern": "mondlift.de", "custom_domain": true },
    { "pattern": "www.mondlift.de", "custom_domain": true }
  ],

  // Öffentliche Variablen. Der Turnstile Site Key ist öffentlich und steht
  // ohnehin im HTML - der Secret Key gehört dagegen in `wrangler secret put`.
  // Leer lassen heißt: kein Widget im Formular.
  "vars": {
    "TURNSTILE_SITE_KEY": ""
  },

  // Rate Limits fürs Kontaktformular, pro IP. Die Periode darf nur 10 oder
  // 60 Sekunden sein, längere Fenster kann dieses Binding nicht.
  // Der strenge Limiter greift nur für Einsendungen ohne Turnstile-Token.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMIT_STRICT",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 }
    }
  ],

  // Zustellung des Kontaktformulars. Darf nur an verifizierte
  // Zieladressen des Accounts senden - siehe README.
  "send_email": [{ "name": "CONTACT_MAILER" }],

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
